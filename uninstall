#!/usr/bin/env bash
set -euo pipefail

remove_on_demand="${1:-}"
[[ -z "$remove_on_demand" || "$remove_on_demand" == "--on-demand" ]] || { echo "usage: ./uninstall [--on-demand]" >&2; exit 1; }

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omatunnel"
unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

systemctl --user disable --now omatunnel.service 2>/dev/null || true
rm -f "$unit_dir/omatunnel.service" "$HOME/.local/bin/omatunnel"
systemctl --user daemon-reload

if [[ "$remove_on_demand" == "--on-demand" ]]; then
  sudo systemctl disable --now "omatunnel-ebpf-reload@${USER}.path" "omatunnel-ebpf@${USER}.service"
  sudo rm -f \
    "/etc/systemd/system/omatunnel-ebpf@.service" \
    "/etc/systemd/system/omatunnel-ebpf-reload@.service" \
    "/etc/systemd/system/omatunnel-ebpf-reload@.path" \
    "/usr/local/lib/omatunnel/omatunnel-ebpf" \
    "/usr/local/lib/omatunnel/omatunnel-connect.bpf.o"
  sudo systemctl daemon-reload
fi

printf 'OmaTunnel helpers removed. Your configuration remains at %s.\n' "$config_dir"
printf 'Remove the widget separately: omarchy plugin remove jvb.omatunnel\n'
